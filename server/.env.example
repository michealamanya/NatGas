# Copy to server/.env for local development. Never commit a real .env file.
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
DATABASE_URL="postgresql://natgas:change-me@localhost:5432/natgas?schema=public"

# Generate long random values for production (minimum 32 bytes).
SESSION_SECRET=replace-with-a-long-random-session-secret
JWT_SECRET=replace-with-a-long-random-jwt-secret
SESSION_EXPIRY_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Local storage (use S3-compatible storage in production)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_LOCAL_URL_BASE=http://localhost:3001/api/uploads

# Email
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=NATGAS Uganda
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Optional S3-compatible storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_CDN_URL=
