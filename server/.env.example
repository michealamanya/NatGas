# NATGAS Uganda — Server environment variables
# ─────────────────────────────────────────────
# Copy this file to server/.env for local development.
# In production, set these variables in your process environment or a secured
# .env file. Never commit a real .env file to version control.
#
# Variables marked REQUIRED must be set before starting in production.
# Variables marked OPTIONAL fall back to the shown defaults if not set.

# ── Runtime ─────────────────────────────────────────────────────────────────

# REQUIRED in production. Use "development" locally.
NODE_ENV=development

# OPTIONAL. TCP port the API server listens on. Must match the PM2 and Nginx config.
PORT=3001

# OPTIONAL. Bind address. Use 127.0.0.1 in production (Nginx proxies in).
HOST=0.0.0.0

# OPTIONAL. Public URL of the React frontend (used in email links).
CLIENT_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────

# REQUIRED. PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://natgas:change-me@localhost:5432/natgas?schema=public"

# ── Security ─────────────────────────────────────────────────────────────────

# REQUIRED in production. Minimum 32 random characters. Must not contain the
# words "dev" or "change" (the startup check rejects insecure values).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret-minimum-32-characters

# OPTIONAL. Session cookie lifetime in days.
SESSION_EXPIRY_DAYS=7

# OPTIONAL. Failed login attempts before account lockout.
MAX_LOGIN_ATTEMPTS=5

# OPTIONAL. Minutes an account stays locked after exceeding MAX_LOGIN_ATTEMPTS.
LOCKOUT_MINUTES=15

# OPTIONAL. Hours a password-reset link remains valid.
PASSWORD_RESET_EXPIRY_HOURS=2

# ── CORS ─────────────────────────────────────────────────────────────────────

# REQUIRED in production. Comma-separated list of allowed frontend origins.
# Must exactly match the scheme, hostname and port of your production domain.
# Example: CORS_ORIGINS=https://natgasuganda.com,https://www.natgasuganda.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── File storage ─────────────────────────────────────────────────────────────

# OPTIONAL. Use "s3" for production. Defaults to "local".
STORAGE_PROVIDER=local

# OPTIONAL. Used when STORAGE_PROVIDER=local.
STORAGE_LOCAL_PATH=./uploads
STORAGE_LOCAL_URL_BASE=http://localhost:3001/api/uploads

# OPTIONAL. Used when STORAGE_PROVIDER=s3. All values required if provider=s3.
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT is only needed for S3-compatible services (e.g. MinIO, Backblaze).
S3_ENDPOINT=
# S3_CDN_URL is the CDN base URL for served assets (e.g. https://cdn.natgasuganda.com).
S3_CDN_URL=

# ── Email ────────────────────────────────────────────────────────────────────

# OPTIONAL. Sender address shown in outgoing emails.
EMAIL_FROM=noreply@natgasuganda.com
EMAIL_FROM_NAME=NATGAS Uganda

# OPTIONAL. SMTP credentials. Leave blank to disable email sending (operations
# will succeed but no emails will be dispatched — a warning is logged instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Set to "true" if the SMTP server uses implicit TLS on port 465.
SMTP_SECURE=false

# OPTIONAL. Used only if EMAIL_PROVIDER=sendgrid.
SENDGRID_API_KEY=

# ── Rate limiting ────────────────────────────────────────────────────────────

# OPTIONAL. General API rate limit window in milliseconds (default: 15 minutes).
RATE_LIMIT_WINDOW_MS=900000

# OPTIONAL. Max requests per window per IP on the general limiter.
RATE_LIMIT_MAX=100

# OPTIONAL. Login rate limit window in milliseconds.
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# OPTIONAL. Max login attempts per window per IP.
LOGIN_RATE_LIMIT_MAX=10

# ── Uploads ──────────────────────────────────────────────────────────────────

# OPTIONAL. Maximum upload size in megabytes.
MAX_FILE_SIZE_MB=10

# ── Maps ─────────────────────────────────────────────────────────────────────

# OPTIONAL. Map provider for location pages. Defaults to "openstreetmap".
MAP_PROVIDER=openstreetmap
MAP_API_KEY=
